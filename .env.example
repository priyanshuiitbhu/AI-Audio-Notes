# ============================================================
# Audio Notes Platform - Environment Configuration Example
# Copy this file to .env and provide your actual credentials.
# ============================================================

# Application Environment
DEBUG=false
PROJECT_NAME="Audio Notes Platform"

# Backend Database (PostgreSQL in production; SQLite fallback for zero-dependency local runs)
# PostgreSQL example: postgresql://postgres:postgrespassword@localhost:5432/audionotes
DATABASE_URL=sqlite:///./audionotes.db

# Redis Task Queue
REDIS_URL=redis://localhost:6379/0

# Gnani Prisma ASR Configuration (Backend Only - NEVER expose to frontend)
# Obtain key from https://app.gnani.ai/voice/speech-to-text
GNANI_API_KEY=your_gnani_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
DEFAULT_LANGUAGE=en-IN

# Audio Storage Configuration ("local" or "s3")
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage
STORAGE_BUCKET=audionotes
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# LLM Summarization Service (OpenAI-compatible: OpenAI, Groq, OpenRouter, Gemini)
# If omitted or left empty, a structured extractive fallback summary is generated automatically.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Security & CORS
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/your-username/audio-notes-platform
