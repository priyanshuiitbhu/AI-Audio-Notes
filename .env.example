# ============================================================
# Audio Notes Platform - Environment Configuration Template
# Copy this file to .env and configure your environment settings.
# ============================================================

# AI Speech & LLM Services (Backend Only - NEVER expose to frontend)
GNANI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./audionotes.db

# Redis Background Task Queue
REDIS_URL=redis://localhost:6379/0
REQUIRE_REDIS_QUEUE=false
RQ_JOB_TIMEOUT_SECONDS=3600

# Object Storage Configuration (Local or S3-compatible: AWS S3, Supabase, Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=audionotes
STORAGE_REGION=us-east-1

# Application Settings
PROJECT_NAME="Audio Notes Platform"
DEBUG=false
DEFAULT_LANGUAGE=en-IN
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/your-username/Audio-Notes-Platform
